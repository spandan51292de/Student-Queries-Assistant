# ==========================================
# Application Settings (Optional Overrides)
# ==========================================
# PROJECT_NAME="Student Queries Assistant"
# ENVIRONMENT="development"
# API_V1_STR="/api/v1"
# BACKEND_CORS_ORIGINS='["http://localhost:8501", "http://localhost:8000", "http://127.0.0.1:8501", "http://127.0.0.1:8000"]'

# ==========================================
# Security (Required)
# ==========================================
# Generate a secure random key (e.g., using `openssl rand -hex 32`)
SECRET_KEY=your_super_secret_key_here_change_in_production
# ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ==========================================
# Relational Database (Required)
# ==========================================
# Make sure to use an async driver like asyncpg for FastAPI
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/your_database_name

# ==========================================
# Vector Database (Optional Overrides)
# ==========================================
# VECTOR_DB_URL="http://localhost:6333"
# VECTOR_DB_COLLECTION="course_documents_hf"

# ==========================================
# LLM Provider (Required)
# ==========================================
GOOGLE_API_KEY=your_google_gemini_api_key_here

# LLM Generation Overrides (Optional)
# LLM_MODEL="gemini-3.6-flash"
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=2048
# LLM_TOP_P=0.9

# ==========================================
# Embedding & RAG Overrides (Optional)
# ==========================================
# EMBEDDING_MODEL="all-MiniLM-L6-v2"
# EMBEDDING_DIMENSION=384
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200