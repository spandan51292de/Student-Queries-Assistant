# Application Settings
PROJECT_NAME="Student Queries Assistant"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security (Run `openssl rand -hex 32` in terminal to generate a real one)
SECRET_KEY="change-this-to-a-secure-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 days

# PostgreSQL Relational Database
# Format: postgresql://user:password@server:port/database_name
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="student_assistant_db"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:5432/${POSTGRES_DB}"

# Vector Database (Qdrant)
VECTOR_DB_URL="http://localhost:6333"

# LLM Provider
OPENAI_API_KEY="sk-your-openai-api-key-here"